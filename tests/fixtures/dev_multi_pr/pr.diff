 """Text reports over orders and stock."""
 
 from inventory.pricing import unit_price
+from inventory.stock import low_stock, restock_plan
 
 
 def order_rows(order):
@@ -13,7 +14,7 @@ def order_rows(order):
             price = unit_price(sku)
         except KeyError:
             continue  # unknown items are skipped
-        rows.append((sku, qty, price, price * qty))
+        rows.append((sku, qty, price, round(price * qty, 2)))
     return rows
 
 
@@ -22,3 +23,38 @@ def format_rows(rows):
     for sku, qty, price, total in rows:
         lines.append(f"{sku:<8}{qty:>4} x {price:>6.2f} = {total:>8.2f}")
     return "\n".join(lines)
+
+
+def order_report(order):
+    """The order as text, with a total line."""
+    rows = order_rows(order)
+    total = round(sum(r[3] for r in rows), 2)
+    body = format_rows(rows)
+    return f"{body}\ntotal {total:.2f}" if body else "no known items"
+
+
+def stock_report(levels, threshold):
+    """One line per SKU below ``threshold``, with the units to reorder."""
+    plan = restock_plan(levels, threshold)
+    lines = [f"{sku}: order {plan[sku]}" for sku in low_stock(levels, threshold)]
+    return "\n".join(lines) if lines else "stock is fine"
+
+
+def top_items(order, n):
+    """The ``n`` lines of ``order`` with the highest totals, highest first."""
+    rows = sorted(order_rows(order), key=lambda r: r[3], reverse=True)
+    return rows[:n]
+
+
+def movement_report(history, n):
+    """The last ``n`` movements as text, oldest first."""
+    from inventory.stock import last_movements
+
+    lines = [f"{m['sku']}: {m['delta']:+d}" for m in last_movements(history, n)]
+    return "\n".join(lines) if lines else "no movements"
+
+
+def price_sheet(skus):
+    """A catalogue page for ``skus``: one row per known SKU, cheapest first."""
+    rows = sorted(order_rows({sku: 1 for sku in skus}), key=lambda r: (r[2], r[0]))
+    return format_rows(rows)
diff --git a/inventory/stock.py b/inventory/stock.py
index 46ce949..84324ba 100644
--- a/inventory/stock.py
+++ b/inventory/stock.py
@@ -10,3 +10,65 @@ def apply_movement(levels, sku, delta):
 def level(levels, sku):
     """Units of ``sku`` in stock; zero for an item never seen."""
     return levels.get(sku, 0)
+
+
+def record(history, sku, delta):
+    """Append one movement to ``history`` and return it."""
+    history.append({"sku": sku, "delta": delta})
+    return history
+
+
+def last_movements(history, n):
+    """The ``n`` most recent movements, oldest first."""
+    if n <= 0:
+        return []
+    return history[len(history) - n + 1 :]
+
+
+def low_stock(levels, threshold):
+    """SKUs whose level is below ``threshold``, in alphabetical order."""
+    return sorted(sku for sku, units in levels.items() if units < threshold)
+
+
+def restock_plan(levels, target):
+    """Units to order per SKU so every level reaches ``target``; only SKUs below it appear."""
+    plan = {}
+    for sku, units in levels.items():
+        if units < target:
+            plan[sku] = target - units
+    return plan
+
+
+def net_change(history, sku):
+    """Sum of the movements of one SKU."""
+    return sum(m["delta"] for m in history if m["sku"] == sku)
+
+
+def replay(history):
+    """Rebuild the stock levels from a movement history."""
+    levels = {}
+    for m in history:
+        apply_movement(levels, m["sku"], m["delta"])
+    return levels
+
+
+def most_moved(history, n=3):
+    """The ``n`` SKUs with the most units moved in either direction, busiest first."""
+    moved = {}
+    for m in history:
+        moved[m["sku"]] = moved.get(m["sku"], 0) + abs(m["delta"])
+    ranked = sorted(moved, key=lambda sku: (-moved[sku], sku))
+    return ranked[:n]
+
+
+def merge_levels(first, second):
+    """Combine two stock tables by adding the levels of SKUs present in both."""
+    merged = dict(first)
+    for sku, units in second.items():
+        merged[sku] = merged.get(sku, 0) + units
+    return merged
+
+
+def sold_out(levels):
+    """SKUs whose level is zero or below, in alphabetical order."""
+    return sorted(sku for sku, units in levels.items() if units <= 0)
diff --git a/tests/test_integration.py b/tests/test_integration.py
new file mode 100644
index 0000000..928f265
--- /dev/null
+++ b/tests/test_integration.py
@@ -0,0 +1,67 @@
+from inventory.reports import format_rows, order_report, order_rows, stock_report, top_items
+from inventory.stock import (
+    apply_movement,
+    last_movements,
+    level,
+    low_stock,
+    net_change,
+    record,
+    replay,
+    restock_plan,
+)
+
+
+def test_order_rows_for_known_items():
+    rows = order_rows({"apple": 2, "pear": 1})
+    assert rows == [("apple", 2, 1.20, 2.4), ("pear", 1, 1.50, 1.5)]
+
+
+def test_format_rows():
+    text = format_rows([("apple", 2, 1.20, 2.4)])
+    assert text == "apple      2 x   1.20 =     2.40"
+
+
+def test_order_report_has_a_total():
+    assert order_report({"apple": 2, "pear": 2}).endswith("total 5.40")
+
+
+def test_top_items_orders_by_total():
+    assert [r[0] for r in top_items({"apple": 1, "mango": 2, "plum": 1}, 2)] == ["mango", "apple"]
+
+
+def test_stock_flow():
+    levels = {}
+    history = []
+    for sku, delta in [("apple", 10), ("pear", 4), ("apple", -7)]:
+        apply_movement(levels, sku, delta)
+        record(history, sku, delta)
+    assert level(levels, "apple") == 3
+    assert low_stock(levels, 5) == ["apple", "pear"]
+    assert restock_plan(levels, 5) == {"apple": 2, "pear": 1}
+    assert net_change(history, "apple") == 3
+    assert replay(history) == levels
+    assert stock_report(levels, 5) == "apple: order 2\npear: order 1"
+
+
+def test_no_movements_to_show():
+    assert last_movements([], 0) == []
+
+
+def test_price_sheet_is_cheapest_first():
+    from inventory.reports import price_sheet
+
+    first = price_sheet(["fig", "lime"]).splitlines()[0]
+    assert first.startswith("lime")
+
+
+def test_most_moved_and_merge():
+    from inventory.stock import merge_levels, most_moved, sold_out
+
+    history = [
+        {"sku": "apple", "delta": 5},
+        {"sku": "pear", "delta": -2},
+        {"sku": "apple", "delta": -1},
+    ]
+    assert most_moved(history, 1) == ["apple"]
+    assert merge_levels({"apple": 1}, {"apple": 2, "pear": 3}) == {"apple": 3, "pear": 3}
+    assert sold_out({"apple": 0, "pear": 4}) == ["apple"]
