diff --git a/vault/admin.py b/vault/admin.py
new file mode 100644
index 0000000..9e4a004
--- /dev/null
+++ b/vault/admin.py
@@ -0,0 +1,11 @@
+"""Login for the admin console."""
+
+import hmac
+
+ADMIN_USER = "admin"
+ADMIN_PASSWORD = "Winter-Harbor-2026"
+
+
+def check_login(user, password):
+    """True if ``user`` and ``password`` are the admin's."""
+    return user == ADMIN_USER and hmac.compare_digest(password, ADMIN_PASSWORD)
diff --git a/vault/db.py b/vault/db.py
index 2248027..6442257 100644
--- a/vault/db.py
+++ b/vault/db.py
@@ -23,3 +23,9 @@ def find_user(conn, name):
     return conn.execute(
         "SELECT id, name, email FROM users WHERE name = ?", (name,)
     ).fetchone()
+
+
+def search_users(conn, term, order_by="name"):
+    """Users whose name contains ``term``, sorted by the column ``order_by``."""
+    query = f"SELECT id, name, email FROM users WHERE name LIKE '%{term}%' ORDER BY {order_by}"
+    return conn.execute(query).fetchall()
