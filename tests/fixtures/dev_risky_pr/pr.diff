diff --git a/ledger/report.py b/ledger/report.py
index 58e6c87..3817dfa 100644
--- a/ledger/report.py
+++ b/ledger/report.py
@@ -3,3 +3,11 @@
 
 def total(amounts):
     return sum(amounts)
+
+
+def running_balances(amounts):
+    """The balance after each amount, in order."""
+    balances = []
+    for i in range(1, len(amounts)):
+        balances.append(sum(amounts[: i + 1]))
+    return balances
